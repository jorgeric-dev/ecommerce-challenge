{
  "ConnectionStrings": {
    "ECommerce": "Server=(localdb)\\MSSQLLocalDB;Database=ECommerce;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": true,
    "SeedSampleProducts": true,
    "MaxRetryCount": 5
  },
  "CatalogCache": {
    "CategoriesTimeToLive": "00:30:00"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
